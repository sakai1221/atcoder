  "bfs": {
    "scope": "cpp",
    "prefix": "bfs",
    "body": [
      "// BFS: dist[v] = 始点 ${3:s} から v への最短距離 (辺の重みはすべて 1)。行けなければ -1",
      "// 頂点は 0..${1:n}-1 の番号にする。グリッドなら (i, j) → i * W + j、",
      "// 状態を足すなら (i, j, k) → (i * W + j) * K + k のように 1 つの番号にまとめる",
      "vector<int> dist($1, -1);",
      "queue<int> q;",
      "dist[$3] = 0;",
      "q.push($3);",
      "while (!q.empty()) {",
      "  int v = q.front();",
      "  q.pop();",
      "  for (int nv : ${2:g}[v]) {  // v から 1 手で行ける頂点 nv を列挙する (グリッドなら 4 方向のループに書き換える)",
      "    if (dist[nv] != -1) continue;  // 先に来た方が最短 (重みが全部 1 なので、入れるときに確定してよい)",
      "    dist[nv] = dist[v] + 1;",
      "    q.push(nv);",
      "  }",
      "}",
      "$0"
    ],
    "description": "BFS の枠 (重みなし最短距離。dist[v] = 始点からの辺の本数)"
