  "0-1 bfs": {
    "scope": "cpp",
    "prefix": "bfs01",
    "body": [
      "// 01-BFS: dist[v] = 始点 ${3:s} から v への最小コスト (辺のコストは 0 か 1)。行けなければ INF",
      "// 頂点は 0..${1:n}-1 の番号にする。グリッドなら (i, j) → i * W + j、",
      "// 状態を足すなら (i, j, k) → (i * W + j) * K + k のように 1 つの番号にまとめる",
      "vector<ll> dist($1, INF);",
      "deque<pair<ll, int>> dq;  // (コスト, 頂点)。前ほどコストが小さい",
      "dist[$3] = 0;",
      "dq.push_back({0, $3});",
      "while (!dq.empty()) {",
      "  auto [d, v] = dq.front();",
      "  dq.pop_front();",
      "  if (d > dist[v]) continue;  // 後からもっと良い値で入り直した古い票は捨てる",
      "  // ここで取り出した v の値 d は最小で確定",
      "  for (auto [nv, cost] : ${2:g}[v]) {  // v から行ける頂点 nv とコスト (0 か 1) を列挙する",
      "    ll nd = d + cost;",
      "    if (nd >= dist[nv]) continue;  // 前より良いときだけ入れる",
      "    dist[nv] = nd;",
      "    if (cost == 0) dq.push_front({nd, nv});  // コスト 0 → 前",
      "    else dq.push_back({nd, nv});             // コスト 1 → 後ろ",
      "  }",
      "}",
      "$0"
    ],
    "description": "01-BFS の枠 (辺のコストが 0 か 1 の最短距離。0 は deque の前、1 は後ろに入れ、取り出したら確定)"
  },
